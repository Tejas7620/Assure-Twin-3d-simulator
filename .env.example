# ASSURE-TWIN Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# =============================================================================
# SECURITY — REQUIRED IN PRODUCTION
# =============================================================================
# Generate a secure random value: python -c "import secrets; print(secrets.token_hex(32))"
# Default in code is an insecure dev key — MUST be overridden in any non-local environment.
SECRET_KEY=change-me-to-a-32-byte-random-hex-string

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default, local development):
DATABASE_URL=sqlite:///./assure_twin.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/assure_twin

# =============================================================================
# CORS (comma-separated allowed origins)
# =============================================================================
# Development (permissive):
# CORS_ORIGINS=*
# Production (restrict):
# CORS_ORIGINS=https://your-app.example.com,https://api.your-app.example.com

# =============================================================================
# OPTIONAL — Economics / Pricing Defaults
# =============================================================================
# These can override the defaults baked into the seed/parameter registry:
# OIL_PRICE_USD_BBL=75.0
# STEAM_COST_USD_TON=24.50
# ELEC_TARIFF_USD_KWH=0.095
